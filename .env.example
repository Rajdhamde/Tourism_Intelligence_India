# Tourism Intelligence India: Environment Configuration

PROJECT_NAME="Tourism Intelligence India"
PROJECT_VERSION="1.0.0"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Database Configuration (SQLite default for out-of-the-box local execution, or PostgreSQL with PostGIS)
DATABASE_URL="sqlite:///tourism_warehouse.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tourism_intelligence_india"

# Optional LLM API Keys (System seamlessly runs with deterministic tool fallback if empty)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""

# Frontend Dev Server URL for CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
